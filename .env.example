# Base URL of the InterChangableTrade-Core API (used by the read-only catalogue).
NEXT_PUBLIC_CORE_API_URL=http://localhost:8080

# Active Stellar network: "testnet" (default) or "public".
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Optional endpoint overrides. Leave unset to use the network defaults
# (Testnet: horizon-testnet.stellar.org / soroban-testnet.stellar.org).
# NEXT_PUBLIC_HORIZON_URL=
# NEXT_PUBLIC_SOROBAN_RPC_URL=

# ---------------------------------------------------------------------------
# Demo script only (scripts/testnet-demo.mjs) — NEVER commit a real secret key.
# Leave blank and the script generates + Friendbot-funds a fresh Testnet account.
# ---------------------------------------------------------------------------
# STELLAR_SECRET_KEY=

# ---------------------------------------------------------------------------
# Trading engine persistence (server-side). Orders, fills and trade history are
# snapshotted to disk so state survives a restart.
#   TRADING_PERSISTENCE = file | memory | none   (default: file)
#   TRADING_STATE_PATH  = snapshot location      (default: ./.trading-engine-state.json)
# ---------------------------------------------------------------------------
# TRADING_PERSISTENCE=file
# TRADING_STATE_PATH=./.trading-engine-state.json

# ---------------------------------------------------------------------------
# API rate limiting (server-side). Fixed-window limits for mutating endpoints.
# Format per variable: <maxRequests>/<windowMs>.
# API_RATE_LIMIT_DEFAULT=60/60000
# per-endpoint overrides:
# API_RATE_LIMIT_ORDERS_CREATE=30/60000
# API_RATE_LIMIT_ORDERS_BATCH=10/60000
# API_RATE_LIMIT_ORDERS_CANCEL=30/60000
# API_RATE_LIMIT_PAYMENTS_CREATE=20/60000
# API_RATE_LIMIT_PAYMENTS_WEBHOOK=120/60000
# API_RATE_LIMIT_ANALYTICS_EVENTS=120/60000
# API_RATE_LIMIT_ADMIN_DISPUTES=30/60000
# API_RATE_LIMIT_ADMIN_LISTINGS=30/60000
# API_RATE_LIMIT_ADMIN_USERS=30/60000
# ---------------------------------------------------------------------------
